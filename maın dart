                              shape: BoxShape.circle,
                              gradient: RadialGradient(
                                colors: isPlayer
                                    ? [
                                        const Color(0xFF616161),
                                        const Color(0xFF1A1A1A),
                                      ]
                                    : [
                                        const Color(0xFFFFFDF5),
                                        const Color(0xFFC9B896),
                                      ],
                              ),
                              border: Border.all(
                                color: Colors.black38,
                                width: 1,
                              ),
                            ),
                          ),
                        )
                        .toList(),
                  ),
          ),
          const Spacer(),
          if (isPlayer) ...[
            _panelButton(
              icon: Icons.undo_rounded,
              label: (_history.isEmpty || isAiThinking)
                  ? 'Geri Al'
                  : (Premium.isPremium
                        ? 'Geri Al'
                        : 'Geri Al (${(freeUndoLimit - undosUsed).clamp(0, freeUndoLimit)})'),
              onPressed: (_history.isEmpty || isAiThinking) ? null : _undo,
            ),
            const SizedBox(height: 8),
            _panelButton(
              icon: Icons.lightbulb_outline_rounded,
              label: isHintLoading
                  ? '...'
                  : (Premium.isPremium
                        ? 'İpucu'
                        : 'İpucu (${(freeHintLimit - hintsUsed).clamp(0, freeHintLimit)})'),
              onPressed:
                  (!whiteTurn || isAiThinking || gameOver || isHintLoading)
                  ? null
                  : _showHint,
            ),
          ] else ...[
            const Text(
              'Zorluk',
              style: TextStyle(color: Colors.white54, fontSize: 11),
            ),
            const SizedBox(height: 6),
            Wrap(
              alignment: WrapAlignment.center,
              spacing: 4,
              runSpacing: 4,
              children: kDifficulties.map((d) => _diffChip(d)).toList(),
            ),
            const SizedBox(height: 12),
            SizedBox(
              width: double.infinity,
              child: ElevatedButton.icon(
                style: ElevatedButton.styleFrom(
                  backgroundColor: theme.accent,
                  foregroundColor: Colors.black,
                  padding: const EdgeInsets.symmetric(
                    horizontal: 8,
                    vertical: 10,
                  ),
                  shape: RoundedRectangleBorder(
                    borderRadius: BorderRadius.circular(24),
                  ),
                ),
                onPressed: _restart,
                icon: const Icon(Icons.refresh, size: 16),
                label: const Text('Yeni Oyun', style: TextStyle(fontSize: 11)),
              ),
            ),
          ],
        ],
      ),
    );
  }

  Widget _panelButton({
    required IconData icon,
    required String label,
    VoidCallback? onPressed,
  }) {
    final enabled = onPressed != null;
    return SizedBox(
      width: double.infinity,
      child: OutlinedButton.icon(
        style: OutlinedButton.styleFrom(
          foregroundColor: enabled ? theme.accent : Colors.white24,
          side: BorderSide(color: enabled ? theme.accent : Colors.white12),
          padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 10),
          shape: RoundedRectangleBorder(
            borderRadius: BorderRadius.circular(20),
          ),
        ),
        onPressed: onPressed,
        icon: Icon(icon, size: 15),
        label: Text(
          label,
          style: const TextStyle(fontSize: 10.5),
          overflow: TextOverflow.ellipsis,
        ),
      ),
    );
  }

  Widget _diffChip(Difficulty d) {
    final selected = difficulty == d.code;
    final locked = d.premium && !Premium.isPremium;
    return GestureDetector(
      onTap: () {
        if (locked) {
          showLockedFeatureDialog(context, d.label);
          return;
        }
        setState(() => difficulty = d.code);
      },
      child: Container(
        padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 5),
        decoration: BoxDecoration(
          color: selected ? theme.accent : Colors.white10,
          borderRadius: BorderRadius.circular(14),
        ),
        child: Row(
          mainAxisSize: MainAxisSize.min,
          children: [
            if (locked)
              Padding(
                padding: const EdgeInsets.only(right: 3),
                child: Icon(
                  Icons.lock_rounded,
                  size: 10,
                  color: selected ? Colors.black54 : Colors.white38,
                ),
              ),
            Text(
              d.label,
              style: TextStyle(
                fontSize: 11,
                color: selected ? Colors.black : Colors.white70,
                fontWeight: selected ? FontWeight.bold : FontWeight.normal,
              ),
            ),
          ],
        ),
      ),
    );
  }
}

