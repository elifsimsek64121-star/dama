class Piece {
  final int id;
  int row;
  int col;
  final bool isWhite;
  bool isKing;
  bool alive;
  Piece({
    required this.id,
    required this.row,
    required this.col,
    required this.isWhite,
    this.isKing = false,
    this.alive = true,
  });
  Piece copy() => Piece(
    id: id,
    row: row,
    col: col,
    isWhite: isWhite,
    isKing: isKing,
    alive: alive,
  );
}

class MoveOption {
  final List<List<int>> path;
  final List<List<int>> captured;
  MoveOption({required this.path, required this.captured});
  bool get isCapture => captured.isNotEmpty;
  List<int> get from => path.first;
  List<int> get to => path.last;
}

class GameSnapshot {
  final Map<int, Piece> pieces;
  final List<List<int>> idGrid;
  final bool whiteTurn;
  final List<String> moveLog;
  GameSnapshot(this.pieces, this.idGrid, this.whiteTurn, this.moveLog);
}

// =======================================================================
// OYUN MOTORU — saf fonksiyonlar (isolate uyumlu)
// Turk Damasi: taslar duz (yatay/dikey) hareket eder, yeme zorunlu, en
// fazla tas yiyen zincir zorunlu, dama kale gibi hareket eder + ucarak yer.
// =======================================================================

const int boardSize = 8;

bool _inBounds(int r, int c) =>
    r >= 0 && r < boardSize && c >= 0 && c < boardSize;

List<List<int>> cloneBoard(List<List<int>> b) =>
    b.map((row) => List<int>.from(row)).toList();

const List<List<int>> _dirs = [
  [-1, 0],
  [1, 0],
  [0, -1],
  [0, 1],
];

List<MoveOption> getAllMoves(List<List<int>> board, bool isWhite) {
  final List<MoveOption> captureMoves = [];
  for (int r = 0; r < boardSize; r++) {
    for (int c = 0; c < boardSize; c++) {
      final v = board[r][c];
      if (v == 0) continue;
      final pieceIsWhite = v > 0;
      if (pieceIsWhite != isWhite) continue;
      final isKing = v.abs() == 2;
      final b2 = cloneBoard(board);
      b2[r][c] = 0;
      final seqs = _exploreCaptures(b2, r, c, isKing, isWhite, [
        [r, c],
      ], []);
      captureMoves.addAll(seqs);
    }
  }
  if (captureMoves.isNotEmpty) {
    final maxLen = captureMoves.map((m) => m.captured.length).reduce(max);
    final best = captureMoves
        .where((m) => m.captured.length == maxLen)
        .toList();
    _orderMoves(best, board);
    return best;
  }
  final simple = _simpleMoves(board, isWhite);
  _orderMoves(simple, board);
  return simple;
}

/// Alfa-beta budamasini iyilestirmek icin hamleleri sirala: tac olacak
/// hamleler ve merkeze yakin hamleler once gelsin.
void _orderMoves(List<MoveOption> moves, List<List<int>> board) {
  int score(MoveOption m) {
    int s = m.captured.length * 100;
    final to = m.to;
    final centerDist = (to[0] - 3.5).abs() + (to[1] - 3.5).abs();
    s += (7 - centerDist).round();
    final v = board[m.from[0]][m.from[1]];
    final willPromote =
        (v == 1 && to[0] == boardSize - 1) || (v == -1 && to[0] == 0);
    if (willPromote) s += 50;
    return s;
  }

  moves.sort((a, b) => score(b).compareTo(score(a)));
}

List<MoveOption> _exploreCaptures(
  List<List<int>> board,
  int curR,
  int curC,
  bool isKing,
  bool isWhite,
  List<List<int>> path,
  List<List<int>> captured,
) {
  final List<MoveOption> moves = [];
  for (final d in _dirs) {
    final dr = d[0], dc = d[1];
    if (isKing) {
      int step = 1;
      List<int>? enemyPos;
      while (true) {
        final nr = curR + dr * step;
        final nc = curC + dc * step;
        if (!_inBounds(nr, nc)) break;
        final val = board[nr][nc];
        if (val == 0) {
          if (enemyPos == null) {
            step++;
            continue;
          } else {
            final nb = cloneBoard(board);
            nb[enemyPos[0]][enemyPos[1]] = 0;
            final newPath = [
              ...path,
              [nr, nc],
            ];
            final newCaptured = [...captured, enemyPos];
            final sub = _exploreCaptures(
              nb,
              nr,
              nc,
              isKing,
              isWhite,
              newPath,
              newCaptured,
            );
            if (sub.isEmpty) {
              moves.add(MoveOption(path: newPath, captured: newCaptured));
            } else {
              moves.addAll(sub);
            }
            step++;
            continue;
          }
        } else {
          final isEnemy = isWhite ? val < 0 : val > 0;
          if (enemyPos == null) {
            if (isEnemy) {
              enemyPos = [nr, nc];
              step++;
              continue;
            } else {
              break;
            }
          } else {
            break;
          }
        }
      }
    } else {
      final nr1 = curR + dr, nc1 = curC + dc;
      final nr2 = curR + dr * 2, nc2 = curC + dc * 2;
      if (!_inBounds(nr2, nc2)) continue;
      if (!_inBounds(nr1, nc1)) continue;
      final mid = board[nr1][nc1];
      final land = board[nr2][nc2];
      final isEnemyMid = mid != 0 && (isWhite ? mid < 0 : mid > 0);
      if (isEnemyMid && land == 0) {
        final nb = cloneBoard(board);
        nb[nr1][nc1] = 0;
        final newPath = [
          ...path,
          [nr2, nc2],
        ];
        final newCaptured = [
          ...captured,
          [nr1, nc1],
        ];
        final sub = _exploreCaptures(
          nb,
          nr2,
          nc2,
          isKing,
          isWhite,
          newPath,
          newCaptured,
        );
        if (sub.isEmpty) {
          moves.add(MoveOption(path: newPath, captured: newCaptured));
        } else {
          moves.addAll(sub);
        }
      }
    }
  }
  return moves;
}

List<MoveOption> _simpleMoves(List<List<int>> board, bool isWhite) {
  final List<MoveOption> moves = [];
  for (int r = 0; r < boardSize; r++) {
    for (int c = 0; c < boardSize; c++) {
      final v = board[r][c];
      if (v == 0) continue;
      final pieceIsWhite = v > 0;
      if (pieceIsWhite != isWhite) continue;
      final isKing = v.abs() == 2;
      if (isKing) {
        for (final d in _dirs) {
          int step = 1;
          while (true) {
            final nr = r + d[0] * step, nc = c + d[1] * step;
            if (!_inBounds(nr, nc) || board[nr][nc] != 0) break;
            moves.add(
              MoveOption(
                path: [
                  [r, c],
                  [nr, nc],
                ],
                captured: [],
              ),
            );
            step++;
          }
        }
      } else {
        final fwd = isWhite ? 1 : -1;
        final candidates = [
          [r + fwd, c],
          [r, c - 1],
          [r, c + 1],
        ];
        for (final cand in candidates) {
          final nr = cand[0], nc = cand[1];
          if (_inBounds(nr, nc) && board[nr][nc] == 0) {
            moves.add(
              MoveOption(
                path: [
                  [r, c],
                  [nr, nc],
                ],
                captured: [],
              ),
            );
          }
        }
      }
    }
  }
  return moves;
}

List<List<int>> applyMoveToBoard(List<List<int>> board, MoveOption m) {
  final nb = cloneBoard(board);
  final from = m.path.first;
  final to = m.path.last;
  int val = nb[from[0]][from[1]];
  nb[from[0]][from[1]] = 0;
  for (final cap in m.captured) {
    nb[cap[0]][cap[1]] = 0;
  }
  if (val == 1 && to[0] == boardSize - 1) val = 2;
  if (val == -1 && to[0] == 0) val = -2;
  nb[to[0]][to[1]] = val;
  return nb;
}

/// Gelismis degerlendirme fonksiyonu:
/// - Malzeme (tas/dama degeri)
/// - Merkez kontrolu
/// - Hareket kabiliyeti (mobilite)
/// - Damalarin serbestligi (ne kadar uzaga hareket edebiliyor)
/// - Geri sira savunmasi (terfi hattinin korunmasi bonusu)
int evaluateBoard(List<List<int>> board) {
  int white = 0, black = 0;
  int whiteKings = 0, blackKings = 0;

  for (int r = 0; r < boardSize; r++) {
    for (int c = 0; c < boardSize; c++) {
      final v = board[r][c];
      if (v == 0) continue;
      final centerBonus = 4 - ((r - 3.5).abs() + (c - 3.5).abs()).round() ~/ 2;
      if (v == 1) {
        white += 100 + r * 3 + centerBonus;
      } else if (v == 2) {
        white += 340 + centerBonus * 2;
        whiteKings++;
      } else if (v == -1) {
        black += 100 + (boardSize - 1 - r) * 3 + centerBonus;
      } else if (v == -2) {
        black += 340 + centerBonus * 2;
        blackKings++;
      }
    }
  }

  // Mobilite: daha fazla oynanabilir hamlesi olan taraf avantajlidir.
  final whiteMoves = getAllMoves(board, true).length;
  final blackMoves = getAllMoves(board, false).length;
  white += whiteMoves * 2;
  black += blackMoves * 2;

  // Dama ustunlugu tek basina cok guclu, kucuk ekstra bonus.
  white += whiteKings * 15;
  black += blackKings * 15;

  return black - white;
}

class _SearchResult {
  final int score;
  final MoveOption? move;
  _SearchResult(this.score, this.move);
}

int _negaMax(
  List<List<int>> board,
  int depth,
  int alpha,
  int beta,
  bool blackToMove,
  Stopwatch sw,
  int timeBudgetMs,
) {
  if (sw.elapsedMilliseconds > timeBudgetMs) {
    return blackToMove ? -evaluateBoard(board) : evaluateBoard(board);
  }
  final isWhite = !blackToMove;
  final moves = getAllMoves(board, isWhite);
  if (moves.isEmpty) {
    return blackToMove ? -100000 - depth : 100000 + depth;
  }
  if (depth == 0) return evaluateBoard(board);
  if (blackToMove) {
    int maxEval = -1 << 30;
    for (final m in moves) {
      final nb = applyMoveToBoard(board, m);
      final ev = _negaMax(nb, depth - 1, alpha, beta, false, sw, timeBudgetMs);
      if (ev > maxEval) maxEval = ev;
      if (maxEval > alpha) alpha = maxEval;
      if (beta <= alpha) break;
    }
    return maxEval;
  } else {
    int minEval = 1 << 30;
    for (final m in moves) {
      final nb = applyMoveToBoard(board, m);
      final ev = _negaMax(nb, depth - 1, alpha, beta, true, sw, timeBudgetMs);
      if (ev < minEval) minEval = ev;
      if (minEval < beta) beta = minEval;
      if (beta <= alpha) break;
    }
    return minEval;
  }
}

_SearchResult _searchAtDepth(
  List<List<int>> board,
  int depth,
  bool isWhite,
  Stopwatch sw,
  int timeBudgetMs,
) {
  final moves = getAllMoves(board, isWhite);
  if (moves.isEmpty) return _SearchResult(0, null);
  MoveOption? bestMove;
  int bestScore = isWhite ? (1 << 30) : (-1 << 30);
  for (final m in moves) {
    final nb = applyMoveToBoard(board, m);
    final score = _negaMax(
      nb,
      depth - 1,
      -1 << 30,
      1 << 30,
      isWhite,
      sw,
      timeBudgetMs,
    );
    if (isWhite) {
      if (score < bestScore) {
        bestScore = score;
        bestMove = m;
      }
    } else {
      if (score > bestScore) {
        bestScore = score;
        bestMove = m;
      }
    }
    if (sw.elapsedMilliseconds > timeBudgetMs) break;
  }
  return _SearchResult(bestScore, bestMove ?? moves.first);
}

/// Genel amacli en iyi hamle bulucu — hem yapay zeka (isWhite:false) hem de
/// oyuncuya ipucu (isWhite:true) icin kullanilir. compute() ile ayri
/// isolate'te calisir, arayuzu kilitlemez.
///
/// Zaman butceli iteratif derinlesme: her zorluk seviyesi icin bir azami
/// derinlik ve bir zaman butcesi (ms) tanimlanir. Derinlik 1'den baslanarak
/// artirilir, sure dolana ya da azami derinlige ulasilana kadar en son
/// tamamlanan derinligin sonucu kullanilir. Bu, sabit derinlige gore hem
/// daha guclu hem de daha tutarli tepki suresi saglar.
Map<String, dynamic> findBestMove(Map<String, dynamic> args) {
  final rawBoard = args['board'] as List;
  final board = rawBoard
      .map<List<int>>((row) => (row as List).map<int>((e) => e as int).toList())
      .toList();
  final maxDepth = args['depth'] as int;
  final isWhite = args['isWhite'] as bool;
  final timeBudgetMs = (args['timeBudgetMs'] as int?) ?? 1500;

  final moves = getAllMoves(board, isWhite);
  if (moves.isEmpty) return {};
  if (moves.length == 1) {
    return {'path': moves.first.path, 'captured': moves.first.captured};
  }

  final sw = Stopwatch()..start();
  MoveOption best = moves.first;

  for (int d = 1; d <= maxDepth; d++) {
    final result = _searchAtDepth(board, d, isWhite, sw, timeBudgetMs);
    if (result.move != null) best = result.move!;
    if (sw.elapsedMilliseconds > timeBudgetMs) break;
    // Kesin kazanan/kaybeden bir sonuc bulunduysa daha fazla aramaya gerek yok.
    if (result.score.abs() > 90000) break;
  }

  return {'path': best.path, 'captured': best.captured};
}

String posToAlgebraic(List<int> pos) =>
    '${String.fromCharCode(97 + pos[1])}${pos[0] + 1}';

