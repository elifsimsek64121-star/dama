class GameScreen extends StatefulWidget {
  final int initialDifficultyCode;
  final BoardTheme theme;
  final VariantConfig variant;
  const GameScreen({
    super.key,
    required this.initialDifficultyCode,
    required this.theme,
    required this.variant,
  });

  @override
  State<GameScreen> createState() => _GameScreenState();
}

class _GameScreenState extends State<GameScreen> {
  static const int freeHintLimit = 3;
  static const int freeUndoLimit = 5;

  late Map<int, Piece> pieces;
  late List<List<int>> idGrid;
  int nextId = 0;
  bool whiteTurn = true;
  bool isAiThinking = false;
  bool isHintLoading = false;
  int? selectedId;
  List<MoveOption> selectableMoves = [];
  List<MoveOption> currentPieceMoves = [];
  bool gameOver = false;
  bool _statsRecorded = false;
  String? statusMessage;
  late int difficulty;
  late BoardTheme theme;
  late VariantConfig variant;
  List<int> lastMoveHighlight = [];
  MoveOption? hintMove;
  List<String> moveLog = [];
  final List<GameSnapshot> _history = [];
  int totalMoves = 0;
  int hintsUsed = 0;
  int undosUsed = 0;
  bool soundOn = true;

  Timer? _clockTimer;
  Duration elapsed = Duration.zero;

  EngineCfg get engineCfg => EngineCfg.fromVariant(variant);

  @override
  void initState() {
    super.initState();
    difficulty = widget.initialDifficultyCode;
    theme = widget.theme;
    variant = widget.variant;
    _setupBoard();
    _clockTimer = Timer.periodic(const Duration(seconds: 1), (_) {
      if (!gameOver && mounted) {
        setState(() => elapsed += const Duration(seconds: 1));
      }
    });
  }

  @override
  void dispose() {
    _clockTimer?.cancel();
    super.dispose();
  }

  // Zorluğa göre azami arama derinliği ve zaman bütçesi (ms).
  int get _maxDepthForDifficulty {
    switch (difficulty) {
      case 1:
        return 4;
      case 2:
        return 6;
      case 4:
        return 9;
      case 6:
        return 12;
      case 8:
        return 14;
      case 10:
        return 16;
      default:
        return 8;
    }
  }

  int get _timeBudgetForDifficulty {
    switch (difficulty) {
      case 1:
        return 300;
      case 2:
        return 600;
      case 4:
        return 1500;
      case 6:
        return 3200;
      case 8:
        return 4800;
      case 10:
        return 6000;
      default:
        return 1200;
    }
  }

  String get _difficultyLabel {
    final d = kDifficulties.firstWhere(
      (d) => d.code == difficulty,
      orElse: () => kDifficulties[2],
    );
    return d.label;
  }

  void _setupBoard() {
    pieces = {};
    final size = variant.size;
    idGrid = List.generate(size, (_) => List.filled(size, -1));
    nextId = 0;

    if (variant.diagonal) {
      final k = size >= 10 ? 4 : 3;
      for (int r = 0; r < k; r++) {
        for (int c = 0; c < size; c++) {
          if ((r + c) % 2 == 0) {
            final p = Piece(id: nextId, row: r, col: c, isWhite: true);
            pieces[nextId] = p;
            idGrid[r][c] = nextId;
            nextId++;
          }
        }
      }
      for (int r = size - k; r < size; r++) {
        for (int c = 0; c < size; c++) {
          if ((r + c) % 2 == 0) {
            final p = Piece(id: nextId, row: r, col: c, isWhite: false);
            pieces[nextId] = p;
            idGrid[r][c] = nextId;
            nextId++;
          }
        }
      }
    } else {
      for (final r in [1, 2]) {
        for (int c = 0; c < size; c++) {
          final p = Piece(id: nextId, row: r, col: c, isWhite: true);
          pieces[nextId] = p;
          idGrid[r][c] = nextId;
          nextId++;
        }
      }
      for (final r in [size - 3, size - 2]) {
        for (int c = 0; c < size; c++) {
          final p = Piece(id: nextId, row: r, col: c, isWhite: false);
          pieces[nextId] = p;
          idGrid[r][c] = nextId;
          nextId++;
        }
      }
    }

    whiteTurn = true;
    selectedId = null;
    currentPieceMoves = [];
    gameOver = false;
    _statsRecorded = false;
    statusMessage = null;
    lastMoveHighlight = [];
    hintMove = null;
    moveLog = [];
    totalMoves = 0;
    hintsUsed = 0;
    undosUsed = 0;
    elapsed = Duration.zero;
    _history.clear();
    _refreshLegalMoves();
  }

  List<List<int>> get valueBoard {
    final size = variant.size;
    final b = List.generate(size, (_) => List.filled(size, 0));
    for (int r = 0; r < size; r++) {
      for (int c = 0; c < size; c++) {
        final id = idGrid[r][c];
        if (id != -1) {
          final p = pieces[id]!;
          b[r][c] = p.isWhite ? (p.isKing ? 2 : 1) : (p.isKing ? -2 : -1);
        }
      }
    }
    return b;
  }

  bool get mustCapture => selectableMoves.any((m) => m.isCapture);

  void _refreshLegalMoves() {
    selectableMoves = getAllMoves(engineCfg, valueBoard, whiteTurn);
    if (selectableMoves.isEmpty) {
      gameOver = true;
      statusMessage = whiteTurn ? 'Yapay Zeka Kazandı' : 'Kazandınız!';
      if (!_statsRecorded) {
        _statsRecorded = true;
        if (whiteTurn) {
          PlayerStats.recordLoss();
        } else {
          PlayerStats.recordWin();
        }
        PlayerStats.totalMovesPlayed += totalMoves;
      }
    }
  }

  Map<int, Piece> _deepCopyPieces() => {
    for (final e in pieces.entries) e.key: e.value.copy(),
  };

  void _pushSnapshot() {
    _history.add(
      GameSnapshot(
        _deepCopyPieces(),
        idGrid.map((r) => List<int>.from(r)).toList(),
        whiteTurn,
        List<String>.from(moveLog),
      ),
    );
    if (_history.length > 60) _history.removeAt(0);
  }

  void _undo() {
    if (isAiThinking || _history.isEmpty) return;
    if (!Premium.isPremium && undosUsed >= freeUndoLimit) {
      showLockedFeatureDialog(
        context,
        'Sınırsız Geri Alma',
        customMessage:
            'Ücretsiz sürümde maç başına $freeUndoLimit geri alma hakkınız var. Sınırsız geri almak için Pro\'ya geçin.',
      );
      return;
    }
    GameSnapshot target;
    if (_history.length >= 2 && _history.last.whiteTurn == false) {
      target = _history[_history.length - 2];
      _history.removeRange(_history.length - 2, _history.length);
    } else {
      target = _history.removeLast();
    }
    undosUsed++;
    setState(() {
      pieces = target.pieces;
      idGrid = target.idGrid;
      whiteTurn = target.whiteTurn;
      moveLog = target.moveLog;
      selectedId = null;
      currentPieceMoves = [];
      gameOver = false;
      statusMessage = null;
      hintMove = null;
      lastMoveHighlight = [];
      _refreshLegalMoves();
    });
  }

  void _playSound(SystemSoundType type) {
    if (soundOn) SystemSound.play(type);
  }

  void _haptic(void Function() fn) {
    if (soundOn) fn();
  }

  void _onCellTap(int r, int c) {
    if (gameOver || !whiteTurn || isAiThinking) return;
    if (hintMove != null) setState(() => hintMove = null);
    final id = idGrid[r][c];
    if (selectedId == null) {
      if (id == -1) return;
      final p = pieces[id]!;
      if (!p.isWhite) return;
      final movesForPiece = selectableMoves
          .where((m) => m.from[0] == r && m.from[1] == c)
          .toList();
      if (movesForPiece.isEmpty) return;
      setState(() {
        selectedId = id;
        currentPieceMoves = movesForPiece;
      });
    } else {
      final match = currentPieceMoves
          .where((m) => m.to[0] == r && m.to[1] == c)
          .toList();
      if (match.isNotEmpty) {
        final move = match.first;
        setState(() {
          selectedId = null;
          currentPieceMoves = [];
        });
        _pushSnapshot();
        _performMove(move, true);
        return;
      }
      if (id != -1 && pieces[id]!.isWhite) {
        final movesForPiece = selectableMoves
            .where((m) => m.from[0] == r && m.from[1] == c)
            .toList();
        if (movesForPiece.isNotEmpty) {
          setState(() {
            selectedId = id;
            currentPieceMoves = movesForPiece;
          });
          return;
        }
      }
      setState(() {
        selectedId = null;
        currentPieceMoves = [];
      });
    }
  }

  Future<void> _performMove(MoveOption move, bool isWhite) async {
    final pieceId = idGrid[move.path[0][0]][move.path[0][1]];
    if (pieceId == -1) return;
    _haptic(HapticFeedback.selectionClick);
    _playSound(SystemSoundType.click);
    for (int i = 1; i < move.path.length; i++) {
      final from = move.path[i - 1];
      final to = move.path[i];
      setState(() {
        idGrid[from[0]][from[1]] = -1;
        idGrid[to[0]][to[1]] = pieceId;
        pieces[pieceId]!.row = to[0];
        pieces[pieceId]!.col = to[1];
        lastMoveHighlight = [from[0], from[1], to[0], to[1]];
      });
      await Future.delayed(const Duration(milliseconds: 260));
      if (move.captured.length > i - 1) {
        final capPos = move.captured[i - 1];
        final capId = idGrid[capPos[0]][capPos[1]];
        if (capId != -1) {
          _haptic(HapticFeedback.lightImpact);
          setState(() {
            pieces[capId]!.alive = false;
            idGrid[capPos[0]][capPos[1]] = -1;
          });
          await Future.delayed(const Duration(milliseconds: 240));
        }
      }
    }
    final lastPos = move.path.last;
    final p = pieces[pieceId]!;
    bool promoted = false;
    if (!p.isKing &&
        ((isWhite && lastPos[0] == variant.size - 1) ||
            (!isWhite && lastPos[0] == 0))) {
      setState(() {
        p.isKing = true;
      });
      _haptic(HapticFeedback.mediumImpact);
      promoted = true;
    }

    final notation =
        '${posToAlgebraic(move.path.first)}${move.isCapture ? 'x' : '-'}${posToAlgebraic(move.path.last)}${promoted ? '★' : ''}';

    if (!mounted) return;
    setState(() {
      pieces.removeWhere((key, value) => !value.alive);
      whiteTurn = !whiteTurn;
      totalMoves++;
      moveLog.add('${isWhite ? 'Siz' : 'YZ'}: $notation');
      _refreshLegalMoves();
    });

    if (!gameOver && !whiteTurn) {
      _aiMove();
    }
  }

  Future<void> _aiMove() async {
    setState(() {
      isAiThinking = true;
    });
    _pushSnapshot();
    await Future.delayed(const Duration(milliseconds: 350));
    final result = await compute(findBestMove, {
      'board': valueBoard,
      'isWhite': false,
      'depth': _maxDepthForDifficulty,
      'timeBudgetMs': _timeBudgetForDifficulty,
      'size': variant.size,
      'diagonal': variant.diagonal,
      'manCaptureBackward': variant.manCaptureBackward,
      'flyingKing': variant.flyingKing,
    });
    if (!mounted) return;
    if (result.isEmpty) {
      setState(() {
        isAiThinking = false;
      });
      return;
    }
    final path = (result['path'] as List)
        .map<List<int>>((e) => (e as List).map<int>((x) => x as int).toList())
        .toList();
    final captured = (result['captured'] as List)
        .map<List<int>>((e) => (e as List).map<int>((x) => x as int).toList())
        .toList();
    final move = MoveOption(path: path, captured: captured);
    setState(() {
      isAiThinking = false;
    });
    await _performMove(move, false);
  }

  Future<void> _showHint() async {
    if (!whiteTurn || isAiThinking || gameOver || isHintLoading) return;
    if (!Premium.isPremium && hintsUsed >= freeHintLimit) {
      showLockedFeatureDialog(
        context,
        'Sınırsız İpucu',
        customMessage:
            'Ücretsiz sürümde maç başına $freeHintLimit ipucu hakkınız var. Sınırsız ipucu için Pro\'ya geçin.',
      );
      return;
    }
    hintsUsed++;
    setState(() => isHintLoading = true);
    final result = await compute(findBestMove, {
      'board': valueBoard,
      'isWhite': true,
      'depth': min(_maxDepthForDifficulty, 8),
      'timeBudgetMs': 1200,
      'size': variant.size,
      'diagonal': variant.diagonal,
      'manCaptureBackward': variant.manCaptureBackward,
      'flyingKing': variant.flyingKing,
    });
    if (!mounted) return;
    setState(() {
      isHintLoading = false;
      if (result.isNotEmpty) {
        final path = (result['path'] as List)
            .map<List<int>>(
              (e) => (e as List).map<int>((x) => x as int).toList(),
            )
            .toList();
        final captured = (result['captured'] as List)
            .map<List<int>>(
              (e) => (e as List).map<int>((x) => x as int).toList(),
            )
            .toList();
        hintMove = MoveOption(path: path, captured: captured);
      }
    });
    Future.delayed(const Duration(seconds: 4), () {
      if (mounted) setState(() => hintMove = null);
    });
  }

