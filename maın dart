// =======================================================================
// OYUNCU İSTATİSTİKLERİ (uygulama açıkken kalıcı, in-memory singleton)
// =======================================================================

class PlayerStats {
  PlayerStats._();
  static int wins = 0;
  static int losses = 0;
  static int gamesPlayed = 0;
  static int currentStreak = 0;
  static int bestStreak = 0;
  static int totalMovesPlayed = 0;

  static double get winRate =>
      gamesPlayed == 0 ? 0 : (wins / gamesPlayed) * 100;

  static void recordWin() {
    wins++;
    gamesPlayed++;
    currentStreak++;
    if (currentStreak > bestStreak) bestStreak = currentStreak;
  }

  static void recordLoss() {
    losses++;
    gamesPlayed++;
    currentStreak = 0;
  }

  static void reset() {
    wins = 0;
    losses = 0;
    gamesPlayed = 0;
    currentStreak = 0;
    bestStreak = 0;
    totalMovesPlayed = 0;
  }
}

