  Widget _buildBoard() {
    return LayoutBuilder(
      builder: (context, constraints) {
        final cell = constraints.maxWidth / boardSize;
        return Stack(
          children: [
            Column(
              children: List.generate(boardSize, (screenRow) {
                final boardRow = boardSize - 1 - screenRow;
                return Row(
                  children: List.generate(boardSize, (col) {
                    final isDark = (boardRow + col) % 2 == 0;
                    final isLastMove =
                        lastMoveHighlight.length == 4 &&
                        ((lastMoveHighlight[0] == boardRow &&
                                lastMoveHighlight[1] == col) ||
                            (lastMoveHighlight[2] == boardRow &&
                                lastMoveHighlight[3] == col));
                    final isValidDest = currentPieceMoves.any(
                      (m) => m.to[0] == boardRow && m.to[1] == col,
                    );
                    final isCaptureDest = currentPieceMoves.any(
                      (m) =>
                          m.to[0] == boardRow && m.to[1] == col && m.isCapture,
                    );
                    final isHintSquare =
                        hintMove != null &&
                        ((hintMove!.from[0] == boardRow &&
                                hintMove!.from[1] == col) ||
                            (hintMove!.to[0] == boardRow &&
                                hintMove!.to[1] == col));
                    return GestureDetector(
                      onTap: () => _onCellTap(boardRow, col),
                      child: Container(
                        width: cell,
                        height: cell,
                        decoration: BoxDecoration(
                          gradient: isDark
                              ? const LinearGradient(
                                  begin: Alignment.topLeft,
                                  end: Alignment.bottomRight,
                                  colors: [
                                    Color(0xFF4A2F21),
                                    Color(0xFF2E1B12),
                                  ],
                                )
                              : const LinearGradient(
                                  begin: Alignment.topLeft,
                                  end: Alignment.bottomRight,
                                  colors: [
                                    Color(0xFFE6CBA1),
                                    Color(0xFFD1AE7C),
                                  ],
                                ),
                        ),
                        child: Stack(
                          alignment: Alignment.center,
                          children: [
                            if (col == 0)
                              Positioned(
                                top: 2,
                                left: 3,
                                child: Text(
                                  '${boardRow + 1}',
                                  style: TextStyle(
                                    fontSize: cell * 0.16,
                                    color:
                                        (isDark ? Colors.white : Colors.black)
                                            .withOpacity(0.35),
                                    fontWeight: FontWeight.bold,
                                  ),
                                ),
                              ),
                            if (boardRow == 0)
                              Positioned(
                                bottom: 2,
                                right: 4,
                                child: Text(
                                  String.fromCharCode(97 + col),
                                  style: TextStyle(
                                    fontSize: cell * 0.16,
                                    color:
                                        (isDark ? Colors.white : Colors.black)
                                            .withOpacity(0.35),
                                    fontWeight: FontWeight.bold,
                                  ),
                                ),
                              ),
                            if (isLastMove)
                              Container(
                                color: const Color(
                                  0xFFC9A227,
                                ).withOpacity(0.25),
                              ),
                            if (isHintSquare)
                              _PulseGlow(
                                color: const Color(0xFF42A5F5),
                                size: cell * 0.9,
                              ),
                            if (isValidDest)
                              _PulseGlow(
                                color: isCaptureDest
                                    ? const Color(0xFFE53935)
                                    : const Color(0xFF43A047),
                                size: cell * (isCaptureDest ? 0.6 : 0.32),
                                filled: !isCaptureDest,
                              ),
                          ],
                        ),
                      ),
                    );
                  }),
                );
              }),
            ),
            if (hintMove != null)
              IgnorePointer(
                child: CustomPaint(
                  size: Size(cell * boardSize, cell * boardSize),
                  painter: _ArrowPainter(
                    from: Offset(
                      hintMove!.from[1] * cell + cell / 2,
                      (boardSize - 1 - hintMove!.from[0]) * cell + cell / 2,
                    ),
                    to: Offset(
                      hintMove!.to[1] * cell + cell / 2,
                      (boardSize - 1 - hintMove!.to[0]) * cell + cell / 2,
                    ),
                  ),
                ),
              ),
            IgnorePointer(
              child: Stack(
                children: pieces.values
                    .map((p) => _buildAnimatedPiece(p, cell))
                    .toList(),
              ),
            ),
            Stack(
              children: pieces.values
                  .where((p) => p.alive)
                  .map((p) => _buildTapArea(p, cell))
                  .toList(),
            ),
          ],
        );
      },
    );
  }

  Widget _buildTapArea(Piece p, double cell) {
    final screenRow = boardSize - 1 - p.row;
