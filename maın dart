  Widget _buildBoard() {
    final size = variant.size;
    return LayoutBuilder(
      builder: (context, constraints) {
        final cell = constraints.maxWidth / size;
        return Stack(
          children: [
            Column(
              children: List.generate(size, (screenRow) {
                final boardRow = size - 1 - screenRow;
                return Row(
                  children: List.generate(size, (col) {
                    final isDark = (boardRow + col) % 2 == 0;
                    final isLastMove =
                        lastMoveHighlight.length == 4 &&
                        ((lastMoveHighlight[0] == boardRow &&
                                lastMoveHighlight[1] == col) ||
                            (lastMoveHighlight[2] == boardRow &&
                                lastMoveHighlight[3] == col));
                    final isValidDest = currentPieceMoves.any(
                      (m) => m.to[0] == boardRow && m.to[1] == col,
                    );
                    final isCaptureDest = currentPieceMoves.any(
                      (m) =>
                          m.to[0] == boardRow && m.to[1] == col && m.isCapture,
                    );
                    final isHintSquare =
                        hintMove != null &&
                        ((hintMove!.from[0] == boardRow &&
                                hintMove!.from[1] == col) ||
                            (hintMove!.to[0] == boardRow &&
                                hintMove!.to[1] == col));
                    return GestureDetector(
                      onTap: () => _onCellTap(boardRow, col),
                      child: Container(
                        width: cell,
                        height: cell,
                        decoration: BoxDecoration(
                          gradient: isDark
                              ? LinearGradient(
                                  begin: Alignment.topLeft,
                                  end: Alignment.bottomRight,
                                  colors: [theme.darkTop, theme.darkBottom],
                                )
                              : LinearGradient(
                                  begin: Alignment.topLeft,
                                  end: Alignment.bottomRight,
                                  colors: [theme.lightTop, theme.lightBottom],
                                ),
                        ),
                        child: Stack(
                          alignment: Alignment.center,
                          children: [
                            if (col == 0)
                              Positioned(
                                top: 2,
                                left: 3,
                                child: Text(
                                  '${boardRow + 1}',
                                  style: TextStyle(
                                    fontSize: cell * 0.16,
                                    color:
                                        (isDark ? Colors.white : Colors.black)
                                            .withOpacity(0.35),
                                    fontWeight: FontWeight.bold,
                                  ),
                                ),
                              ),
                            if (boardRow == 0)
                              Positioned(
                                bottom: 2,
                                right: 4,
                                child: Text(
                                  String.fromCharCode(97 + col),
                                  style: TextStyle(
                                    fontSize: cell * 0.16,
                                    color:
                                        (isDark ? Colors.white : Colors.black)
                                            .withOpacity(0.35),
                                    fontWeight: FontWeight.bold,
                                  ),
                                ),
                              ),
                            if (isLastMove)
                              Container(color: theme.accent.withOpacity(0.25)),
                            if (isHintSquare)
                              _PulseGlow(
                                color: const Color(0xFF42A5F5),
                                size: cell * 0.9,
                              ),
                            if (isValidDest)
                              _PulseGlow(
                                color: isCaptureDest
                                    ? const Color(0xFFE53935)
                                    : const Color(0xFF43A047),
                                size: cell * (isCaptureDest ? 0.6 : 0.32),
                                filled: !isCaptureDest,
                              ),
                          ],
                        ),
                      ),
                    );
                  }),
                );
              }),
            ),
            if (hintMove != null)
              IgnorePointer(
                child: CustomPaint(
                  size: Size(cell * size, cell * size),
                  painter: _ArrowPainter(
                    from: Offset(
                      hintMove!.from[1] * cell + cell / 2,
                      (size - 1 - hintMove!.from[0]) * cell + cell / 2,
                    ),
                    to: Offset(
                      hintMove!.to[1] * cell + cell / 2,
                      (size - 1 - hintMove!.to[0]) * cell + cell / 2,
                    ),
                  ),
                ),
              ),
            IgnorePointer(
              child: Stack(
                children: pieces.values
                    .map((p) => _buildAnimatedPiece(p, cell))
                    .toList(),
              ),
            ),
            Stack(
              children: pieces.values
                  .where((p) => p.alive)
                  .map((p) => _buildTapArea(p, cell))
                  .toList(),
            ),
          ],
        );
      },
    );
  }

  Widget _buildTapArea(Piece p, double cell) {
    final size = variant.size;
    final screenRow = size - 1 - p.row;
    return AnimatedPositioned(
      key: ValueKey('tap_${p.id}'),
      duration: const Duration(milliseconds: 260),
      curve: Curves.easeInOutCubic,
      left: p.col * cell,
      top: screenRow * cell,
      width: cell,
      height: cell,
      child: GestureDetector(
        behavior: HitTestBehavior.translucent,
        onTap: () => _onCellTap(p.row, p.col),
      ),
    );
  }

  Widget _buildAnimatedPiece(Piece p, double cell) {
    final size = variant.size;
    final screenRow = size - 1 - p.row;
    final isSelectedPiece = selectedId == p.id;
    return AnimatedPositioned(
      key: ValueKey('piece_${p.id}'),
      duration: const Duration(milliseconds: 260),
      curve: Curves.easeInOutCubic,
      left: p.col * cell,
      top: screenRow * cell,
      width: cell,
      height: cell,
      child: AnimatedOpacity(
        duration: const Duration(milliseconds: 260),
        opacity: p.alive ? 1.0 : 0.0,
        child: AnimatedScale(
          duration: const Duration(milliseconds: 200),
          curve: Curves.easeOutBack,
          scale: isSelectedPiece ? 1.12 : (p.alive ? 1.0 : 0.3),
          child: Stack(
            alignment: Alignment.center,
            children: [
              Align(
                alignment: const Alignment(0, 0.72),
                child: Container(
                  width: cell * 0.62,
                  height: cell * 0.16,
                  decoration: BoxDecoration(
                    borderRadius: BorderRadius.circular(30),
                    boxShadow: [
                      BoxShadow(
                        color: Colors.black.withOpacity(0.5),
                        blurRadius: cell * 0.14,
                      ),
                    ],
                  ),
                ),
              ),
              Padding(
                padding: EdgeInsets.all(cell * 0.1),
                child: _PieceVisual(
                  isWhite: p.isWhite,
                  isKing: p.isKing,
                  cellSize: cell,
                  glow: isSelectedPiece,
                  accent: theme.accent,
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }

