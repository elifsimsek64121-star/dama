// =======================================================================
// MODELLER
// =======================================================================

class Piece {
  final int id;
  int row;
  int col;
  final bool isWhite;
  bool isKing;
  bool alive;
  Piece({
    required this.id,
    required this.row,
    required this.col,
    required this.isWhite,
    this.isKing = false,
    this.alive = true,
  });
  Piece copy() => Piece(
    id: id,
    row: row,
    col: col,
    isWhite: isWhite,
    isKing: isKing,
    alive: alive,
  );
}

class MoveOption {
  final List<List<int>> path;
  final List<List<int>> captured;
  MoveOption({required this.path, required this.captured});
  bool get isCapture => captured.isNotEmpty;
  List<int> get from => path.first;
  List<int> get to => path.last;
}

class GameSnapshot {
  final Map<int, Piece> pieces;
  final List<List<int>> idGrid;
  final bool whiteTurn;
  final List<String> moveLog;
  GameSnapshot(this.pieces, this.idGrid, this.whiteTurn, this.moveLog);
}

// =======================================================================
// OYUN MOTORU — saf fonksiyonlar (isolate uyumlu), varyanta göre
// genelleştirilmiş: düz/çapraz hareket, uçan/tek adım dama, ileri/geri yeme.
// =======================================================================

class EngineCfg {
  final int size;
  final bool diagonal;
  final bool manCaptureBackward;
  final bool flyingKing;
  const EngineCfg({
    required this.size,
    required this.diagonal,
    required this.manCaptureBackward,
    required this.flyingKing,
  });

  factory EngineCfg.fromVariant(VariantConfig v) => EngineCfg(
    size: v.size,
    diagonal: v.diagonal,
    manCaptureBackward: v.manCaptureBackward,
    flyingKing: v.flyingKing,
  );
}

bool _inBounds(int r, int c, int size) =>
    r >= 0 && r < size && c >= 0 && c < size;

List<List<int>> cloneBoard(List<List<int>> b) =>
    b.map((row) => List<int>.from(row)).toList();

List<List<int>> _kingDirs(bool diagonal) => diagonal
    ? const [
        [-1, -1],
        [-1, 1],
        [1, -1],
        [1, 1],
      ]
    : const [
        [-1, 0],
        [1, 0],
        [0, -1],
        [0, 1],
      ];

List<List<int>> _manMoveDirs(bool diagonal, bool isWhite) {
  final fwd = isWhite ? 1 : -1;
  if (diagonal) {
    return [
      [fwd, -1],
      [fwd, 1],
    ];
  }
  return [
    [fwd, 0],
    [0, -1],
    [0, 1],
  ];
}

List<List<int>> _manCaptureDirs(
  bool diagonal,
  bool manCaptureBackward,
  bool isWhite,
) {
  if (manCaptureBackward) return _kingDirs(diagonal);
  final fwd = isWhite ? 1 : -1;
  if (diagonal) {
    return [
      [fwd, -1],
      [fwd, 1],
    ];
  }
  return [
    [fwd, 0],
    [0, -1],
    [0, 1],
  ];
}

List<MoveOption> getAllMoves(
  EngineCfg cfg,
  List<List<int>> board,
  bool isWhite,
) {
  final size = cfg.size;
  final List<MoveOption> captureMoves = [];
  for (int r = 0; r < size; r++) {
    for (int c = 0; c < size; c++) {
      final v = board[r][c];
      if (v == 0) continue;
      final pieceIsWhite = v > 0;
      if (pieceIsWhite != isWhite) continue;
      final isKing = v.abs() == 2;
      final b2 = cloneBoard(board);
      b2[r][c] = 0;
      final seqs = _exploreCaptures(cfg, b2, r, c, isKing, isWhite, [
        [r, c],
      ], []);
      captureMoves.addAll(seqs);
    }
  }
  if (captureMoves.isNotEmpty) {
    final maxLen = captureMoves.map((m) => m.captured.length).reduce(max);
    final best = captureMoves
        .where((m) => m.captured.length == maxLen)
        .toList();
    _orderMoves(best, board, size);
    return best;
  }
  final simple = _simpleMoves(cfg, board, isWhite);
  _orderMoves(simple, board, size);
  return simple;
}

/// Alfa-beta budamasını iyileştirmek için hamleleri sırala: taç olacak
/// hamleler ve merkeze yakın hamleler önce gelsin.
void _orderMoves(List<MoveOption> moves, List<List<int>> board, int size) {
  final center = (size - 1) / 2.0;
  int score(MoveOption m) {
    int s = m.captured.length * 100;
    final to = m.to;
    final centerDist = (to[0] - center).abs() + (to[1] - center).abs();
    s += (size - centerDist).round();
    final v = board[m.from[0]][m.from[1]];
    final willPromote =
        (v == 1 && to[0] == size - 1) || (v == -1 && to[0] == 0);
    if (willPromote) s += 50;
    return s;
  }

  moves.sort((a, b) => score(b).compareTo(score(a)));
}

List<MoveOption> _exploreCaptures(
  EngineCfg cfg,
  List<List<int>> board,
  int curR,
  int curC,
  bool isKing,
  bool isWhite,
  List<List<int>> path,
  List<List<int>> captured,
) {
  final size = cfg.size;
  final dirs = isKing
      ? _kingDirs(cfg.diagonal)
      : _manCaptureDirs(cfg.diagonal, cfg.manCaptureBackward, isWhite);
  final sliding = isKing && cfg.flyingKing;
  final List<MoveOption> moves = [];
  for (final d in dirs) {
    final dr = d[0], dc = d[1];
    if (sliding) {
      int step = 1;
      List<int>? enemyPos;
      while (true) {
        final nr = curR + dr * step;
        final nc = curC + dc * step;
        if (!_inBounds(nr, nc, size)) break;
        final val = board[nr][nc];
        if (val == 0) {
          if (enemyPos == null) {
            step++;
            continue;
          } else {
            final nb = cloneBoard(board);
            nb[enemyPos[0]][enemyPos[1]] = 0;
            final newPath = [
              ...path,
              [nr, nc],
            ];
            final newCaptured = [...captured, enemyPos];
            final sub = _exploreCaptures(
              cfg,
              nb,
              nr,
              nc,
              isKing,
              isWhite,
              newPath,
              newCaptured,
            );
            if (sub.isEmpty) {
              moves.add(MoveOption(path: newPath, captured: newCaptured));
            } else {
              moves.addAll(sub);
            }
            step++;
            continue;
          }
        } else {
          final isEnemy = isWhite ? val < 0 : val > 0;
          if (enemyPos == null) {
            if (isEnemy) {
              enemyPos = [nr, nc];
              step++;
              continue;
            } else {
              break;
            }
          } else {
            break;
          }
        }
      }
    } else {
      final nr1 = curR + dr, nc1 = curC + dc;
      final nr2 = curR + dr * 2, nc2 = curC + dc * 2;
      if (!_inBounds(nr2, nc2, size)) continue;
      if (!_inBounds(nr1, nc1, size)) continue;
      final mid = board[nr1][nc1];
      final land = board[nr2][nc2];
      final isEnemyMid = mid != 0 && (isWhite ? mid < 0 : mid > 0);
      if (isEnemyMid && land == 0) {
        final nb = cloneBoard(board);
        nb[nr1][nc1] = 0;
        final newPath = [
          ...path,
          [nr2, nc2],
        ];
        final newCaptured = [
          ...captured,
          [nr1, nc1],
        ];
        final sub = _exploreCaptures(
          cfg,
          nb,
          nr2,
          nc2,
          isKing,
          isWhite,
          newPath,
          newCaptured,
        );
        if (sub.isEmpty) {
          moves.add(MoveOption(path: newPath, captured: newCaptured));
        } else {
          moves.addAll(sub);
        }
      }
    }
  }
  return moves;
}

List<MoveOption> _simpleMoves(
  EngineCfg cfg,
  List<List<int>> board,
  bool isWhite,
) {
  final size = cfg.size;
  final List<MoveOption> moves = [];
  for (int r = 0; r < size; r++) {
    for (int c = 0; c < size; c++) {
      final v = board[r][c];
      if (v == 0) continue;
      final pieceIsWhite = v > 0;
      if (pieceIsWhite != isWhite) continue;
      final isKing = v.abs() == 2;
      if (isKing) {
        final dirs = _kingDirs(cfg.diagonal);
        if (cfg.flyingKing) {
          for (final d in dirs) {
            int step = 1;
            while (true) {
              final nr = r + d[0] * step, nc = c + d[1] * step;
              if (!_inBounds(nr, nc, size) || board[nr][nc] != 0) break;
              moves.add(
                MoveOption(
                  path: [
                    [r, c],
                    [nr, nc],
                  ],
                  captured: [],
                ),
              );
              step++;
            }
          }
        } else {
          for (final d in dirs) {
            final nr = r + d[0], nc = c + d[1];
            if (_inBounds(nr, nc, size) && board[nr][nc] == 0) {
              moves.add(
                MoveOption(
                  path: [
                    [r, c],
                    [nr, nc],
                  ],
                  captured: [],
                ),
              );
            }
          }
        }
      } else {
        final dirs = _manMoveDirs(cfg.diagonal, isWhite);
        for (final d in dirs) {
          final nr = r + d[0], nc = c + d[1];
          if (_inBounds(nr, nc, size) && board[nr][nc] == 0) {
            moves.add(
              MoveOption(
                path: [
                  [r, c],
                  [nr, nc],
                ],
                captured: [],
              ),
            );
          }
        }
      }
    }
  }
  return moves;
}

List<List<int>> applyMoveToBoard(
  EngineCfg cfg,
  List<List<int>> board,
  MoveOption m,
) {
  final nb = cloneBoard(board);
  final from = m.path.first;
  final to = m.path.last;
  int val = nb[from[0]][from[1]];
  nb[from[0]][from[1]] = 0;
  for (final cap in m.captured) {
    nb[cap[0]][cap[1]] = 0;
  }
  if (val == 1 && to[0] == cfg.size - 1) val = 2;
  if (val == -1 && to[0] == 0) val = -2;
  nb[to[0]][to[1]] = val;
  return nb;
}

/// Gelişmiş değerlendirme fonksiyonu:
/// - Malzeme (taş/dama değeri)
/// - Merkez kontrolü
/// - Hareket kabiliyeti (mobilite)
/// - Dama üstünlüğü
int evaluateBoard(EngineCfg cfg, List<List<int>> board) {
  final size = cfg.size;
  final center = (size - 1) / 2.0;
  int white = 0, black = 0;
  int whiteKings = 0, blackKings = 0;

  for (int r = 0; r < size; r++) {
    for (int c = 0; c < size; c++) {
      final v = board[r][c];
      if (v == 0) continue;
      final centerBonus =
          (size ~/ 2) -
          (((r - center).abs() + (c - center).abs())).round() ~/ 2;
      if (v == 1) {
        white += 100 + r * 3 + centerBonus;
      } else if (v == 2) {
        white += 340 + centerBonus * 2;
        whiteKings++;
      } else if (v == -1) {
        black += 100 + (size - 1 - r) * 3 + centerBonus;
      } else if (v == -2) {
        black += 340 + centerBonus * 2;
        blackKings++;
      }
    }
  }

  final whiteMoves = getAllMoves(cfg, board, true).length;
  final blackMoves = getAllMoves(cfg, board, false).length;
  white += whiteMoves * 2;
  black += blackMoves * 2;

  white += whiteKings * 15;
  black += blackKings * 15;

  return black - white;
}

class _SearchResult {
  final int score;
  final MoveOption? move;
  _SearchResult(this.score, this.move);
}

int _negaMax(
  EngineCfg cfg,
  List<List<int>> board,
  int depth,
  int alpha,
  int beta,
  bool blackToMove,
  Stopwatch sw,
  int timeBudgetMs,
) {
  if (sw.elapsedMilliseconds > timeBudgetMs) {
    return blackToMove ? -evaluateBoard(cfg, board) : evaluateBoard(cfg, board);
  }
  final isWhite = !blackToMove;
  final moves = getAllMoves(cfg, board, isWhite);
  if (moves.isEmpty) {
    return blackToMove ? -100000 - depth : 100000 + depth;
  }
  if (depth == 0) return evaluateBoard(cfg, board);
  if (blackToMove) {
    int maxEval = -1 << 30;
    for (final m in moves) {
      final nb = applyMoveToBoard(cfg, board, m);
      final ev = _negaMax(
        cfg,
        nb,
        depth - 1,
        alpha,
        beta,
        false,
        sw,
        timeBudgetMs,
      );
      if (ev > maxEval) maxEval = ev;
      if (maxEval > alpha) alpha = maxEval;
      if (beta <= alpha) break;
    }
    return maxEval;
  } else {
    int minEval = 1 << 30;
    for (final m in moves) {
      final nb = applyMoveToBoard(cfg, board, m);
      final ev = _negaMax(
        cfg,
        nb,
        depth - 1,
        alpha,
        beta,
        true,
        sw,
        timeBudgetMs,
      );
      if (ev < minEval) minEval = ev;
      if (minEval < beta) beta = minEval;
      if (beta <= alpha) break;
    }
    return minEval;
  }
}

_SearchResult _searchAtDepth(
  EngineCfg cfg,
  List<List<int>> board,
  int depth,
  bool isWhite,
  Stopwatch sw,
  int timeBudgetMs,
) {
  final moves = getAllMoves(cfg, board, isWhite);
  if (moves.isEmpty) return _SearchResult(0, null);
  MoveOption? bestMove;
  int bestScore = isWhite ? (1 << 30) : (-1 << 30);
  for (final m in moves) {
    final nb = applyMoveToBoard(cfg, board, m);
    final score = _negaMax(
      cfg,
      nb,
      depth - 1,
      -1 << 30,
      1 << 30,
      isWhite,
      sw,
      timeBudgetMs,
    );
    if (isWhite) {
      if (score < bestScore) {
        bestScore = score;
        bestMove = m;
      }
    } else {
      if (score > bestScore) {
        bestScore = score;
        bestMove = m;
      }
    }
    if (sw.elapsedMilliseconds > timeBudgetMs) break;
  }
  return _SearchResult(bestScore, bestMove ?? moves.first);
}

/// Genel amaçlı en iyi hamle bulucu — hem yapay zekâ (isWhite:false) hem de
/// oyuncuya ipucu (isWhite:true) için kullanılır. compute() ile ayrı
/// isolate'te çalışır, arayüzü kilitlemez. Varyant bilgisi (size, diagonal,
/// manCaptureBackward, flyingKing) sade tiplerle args map'i üzerinden taşınır.
Map<String, dynamic> findBestMove(Map<String, dynamic> args) {
  final rawBoard = args['board'] as List;
  final board = rawBoard
      .map<List<int>>((row) => (row as List).map<int>((e) => e as int).toList())
      .toList();
  final maxDepth = args['depth'] as int;
  final isWhite = args['isWhite'] as bool;
  final timeBudgetMs = (args['timeBudgetMs'] as int?) ?? 1500;
  final cfg = EngineCfg(
    size: args['size'] as int,
    diagonal: args['diagonal'] as bool,
    manCaptureBackward: args['manCaptureBackward'] as bool,
    flyingKing: args['flyingKing'] as bool,
  );

  final moves = getAllMoves(cfg, board, isWhite);
  if (moves.isEmpty) return {};
  if (moves.length == 1) {
    return {'path': moves.first.path, 'captured': moves.first.captured};
  }

  final sw = Stopwatch()..start();
  MoveOption best = moves.first;

  for (int d = 1; d <= maxDepth; d++) {
    final result = _searchAtDepth(cfg, board, d, isWhite, sw, timeBudgetMs);
    if (result.move != null) best = result.move!;
    if (sw.elapsedMilliseconds > timeBudgetMs) break;
    if (result.score.abs() > 90000) break;
  }

  return {'path': best.path, 'captured': best.captured};
}

