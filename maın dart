  });
  @override
  State<_PulseGlow> createState() => _PulseGlowState();
}

class _PulseGlowState extends State<_PulseGlow>
    with SingleTickerProviderStateMixin {
  late AnimationController _ctrl;
  @override
  void initState() {
    super.initState();
    _ctrl = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 900),
    )..repeat(reverse: true);
  }

  @override
  void dispose() {
    _ctrl.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return AnimatedBuilder(
      animation: _ctrl,
      builder: (context, child) {
        final t = 0.85 + _ctrl.value * 0.25;
        return Container(
          width: widget.size * t,
          height: widget.size * t,
          decoration: BoxDecoration(
            shape: BoxShape.circle,
            color: widget.filled
                ? widget.color.withOpacity(0.75)
                : Colors.transparent,
            border: widget.filled
                ? null
                : Border.all(color: widget.color.withOpacity(0.85), width: 3),
            boxShadow: [
              BoxShadow(color: widget.color.withOpacity(0.5), blurRadius: 10),
            ],
          ),
        );
      },
    );
  }
}

